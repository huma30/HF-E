rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function activeStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.isActive == true;
    }

    function superAdmin() {
      return activeStaff()
        && adminDoc().data.role == 'SUPER_ADMIN';
    }

    function managerOrAbove() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER'];
    }

    function staff() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'CASHIER'];
    }

    // ------------------------------------------------------------
    // PUBLIC STOREFRONT READ-ONLY DATA
    // ------------------------------------------------------------

    match /settings/{docId} {
      allow read: if true;

      // Normal settings/configuration remains manager+ only.
      allow write: if managerOrAbove()
        || (
          docId == 'orderCounter'
          && staff()
          && request.resource.data.keys().hasOnly(['lastNumber'])
          && request.resource.data.lastNumber is int
          && request.resource.data.lastNumber == resource.data.lastNumber + 1
        );

      // First creation of the sequential counter.
      allow create: if docId == 'orderCounter'
        && staff()
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == 101;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /products/{docId} {
      allow read: if true;

      allow create, delete: if managerOrAbove();

      allow update: if managerOrAbove()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock',
            'updatedAt',
            'inventoryOperationId',
            'inventoryOrderId',
            'inventoryOperationType'
          ])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.inventoryOperationId is string
          && request.resource.data.inventoryOperationType in [
            'SALE',
            'CANCEL',
            'REDEEM_REWARD'
          ]
          && (
            (
              request.resource.data.inventoryOperationType == 'SALE'
              && request.resource.data.inventoryOrderId is string
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryOperationId ==
                request.resource.data.inventoryOrderId
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked is map
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked[docId] is int
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked[docId] > 0
              && request.resource.data.stock ==
                resource.data.stock -
                getAfter(
                  /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                ).data.inventoryTracked[docId]
              && (
                (
                  getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                  ).data.source == 'WEB'
                  && getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                  ).data.status == 'PENDING'
                )
                ||
                (
                  getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                  ).data.source == 'POS'
                  && getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                  ).data.status == 'COMPLETED'
                  && staff()
                )
              )
            )
            ||
            (
              request.resource.data.inventoryOperationType == 'CANCEL'
              && request.resource.data.inventoryOrderId is string
              && staff()
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.status == 'CANCELLED'
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryRestored == true
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryRestorationOperationId ==
                request.resource.data.inventoryOperationId
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked is map
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked[docId] is int
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryTracked[docId] > 0
              && request.resource.data.stock ==
                resource.data.stock +
                getAfter(
                  /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
                ).data.inventoryTracked[docId]
            )
            ||
            (
              request.resource.data.inventoryOperationType == 'REDEEM_REWARD'
              && getAfter(
                /databases/$(database)/documents/pointRedemptions/$(request.resource.data.inventoryOperationId)
              ).data.inventoryOperationId ==
                request.resource.data.inventoryOperationId
              && getAfter(
                /databases/$(database)/documents/pointRedemptions/$(request.resource.data.inventoryOperationId)
              ).data.type == 'PRODUCT'
              && getAfter(
                /databases/$(database)/documents/pointRedemptions/$(request.resource.data.inventoryOperationId)
              ).data.productId == docId
              && getAfter(
                /databases/$(database)/documents/pointRedemptions/$(request.resource.data.inventoryOperationId)
              ).data.status == 'COMPLETED'
              && request.resource.data.stock ==
                resource.data.stock - 1
            )
          )
        );
    }

    match /modifierGroups/{docId} {
      allow read: if true;
      allow create, delete: if managerOrAbove();

      allow update: if managerOrAbove()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items',
            'updatedAt',
            'inventoryOperationId',
            'inventoryOrderId',
            'inventoryOperationType'
          ])
          && request.resource.data.inventoryOperationId is string
          && request.resource.data.inventoryOrderId is string
          && request.resource.data.inventoryOperationType in ['SALE', 'CANCEL']
          && (
            (
              request.resource.data.inventoryOperationType == 'SALE'
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryOperationId ==
                request.resource.data.inventoryOrderId
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.source == 'WEB'
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.status == 'PENDING'
            )
            ||
            (
              request.resource.data.inventoryOperationType == 'SALE'
              && staff()
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryOperationId ==
                request.resource.data.inventoryOrderId
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.source == 'POS'
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.status == 'COMPLETED'
            )
            ||
            (
              request.resource.data.inventoryOperationType == 'CANCEL'
              && staff()
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.status == 'CANCELLED'
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryRestored == true
              && getAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.inventoryOrderId)
              ).data.inventoryRestorationOperationId ==
                request.resource.data.inventoryOperationId
            )
          )
        );
    }

    match /promos/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /deliveryAreas/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /platformLinks/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /rewards/{docId} {
      allow read: if true;

      allow create, delete: if managerOrAbove();

      allow update: if managerOrAbove()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'redeemCount',
            'stock',
            'lastRedemptionId'
          ])
          && request.resource.data.redeemCount is int
          && request.resource.data.redeemCount ==
            resource.data.redeemCount + 1
          && request.resource.data.lastRedemptionId is string
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.rewardId == docId
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.inventoryOperationId ==
            request.resource.data.lastRedemptionId
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.status == 'COMPLETED'
          && (
            (
              resource.data.type == 'PRODUCT'
              && (
                !resource.data.keys().hasAny(['stock'])
                ||
                (
                  resource.data.stock is int
                  && request.resource.data.stock ==
                    resource.data.stock
                )
              )
            )
            ||
            (
              resource.data.type == 'DISCOUNT'
              && resource.data.stock is int
              && request.resource.data.stock ==
                resource.data.stock - 1
            )
          )
        )
        || (
          staff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'redeemCount',
            'stock',
            'lastCancelledRedemptionId'
          ])
          && resource.data.redeemCount is int
          && resource.data.redeemCount > 0
          && request.resource.data.redeemCount is int
          && request.resource.data.redeemCount ==
            resource.data.redeemCount - 1
          && request.resource.data.lastCancelledRedemptionId is string
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastCancelledRedemptionId)
          ).data.rewardId == docId
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastCancelledRedemptionId)
          ).data.status == 'CANCELLED'
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastCancelledRedemptionId)
          ).data.createdBy == 'CUSTOMER_INSTANT'
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastCancelledRedemptionId)
          ).data.pointsSpent is int
          && getAfter(
            /databases/$(database)/documents/pointRedemptions/$(request.resource.data.lastCancelledRedemptionId)
          ).data.pointsSpent > 0
          && (
            (
              resource.data.type == 'PRODUCT'
              && (
                !resource.data.keys().hasAny(['stock'])
                ||
                (
                  resource.data.stock is int
                  && request.resource.data.stock ==
                    resource.data.stock
                )
              )
            )
            ||
            (
              resource.data.type == 'DISCOUNT'
              && resource.data.stock is int
              && request.resource.data.stock ==
                resource.data.stock + 1
            )
          )
        );
    }

    // ------------------------------------------------------------
    // PRODUCT DUPLICATE / REGISTRY DATA
    // ------------------------------------------------------------

    match /product_names/{docId} {
      allow read, write: if managerOrAbove();
    }

    match /product_skus/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // ORDER IDEMPOTENCY
    //
    // The customer checkout transaction uses this document as an
    // atomic duplicate-order lock. The document is readable only
    // by the checkout transaction and may only be created together
    // with its matching WEB order.
    // ------------------------------------------------------------

    match /orderIdempotency/{docId} {
      allow get: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'idempotencyKey',
          'orderId',
          'createdAt',
          'status'
        ])
        && request.resource.data.idempotencyKey is string
        && request.resource.data.orderId is string
        && request.resource.data.createdAt is string
        && request.resource.data.status == 'COMMITTED'
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.inventoryOperationId ==
          request.resource.data.orderId
        && (
          (
            getAfter(
              /databases/$(database)/documents/orders/$(request.resource.data.orderId)
            ).data.source == 'WEB'
            && getAfter(
              /databases/$(database)/documents/orders/$(request.resource.data.orderId)
            ).data.status == 'PENDING'
          )
          ||
          (
            getAfter(
              /databases/$(database)/documents/orders/$(request.resource.data.orderId)
            ).data.source == 'POS'
            && getAfter(
              /databases/$(database)/documents/orders/$(request.resource.data.orderId)
            ).data.status == 'COMPLETED'
            && staff()
          )
        );
    }

    // ------------------------------------------------------------
    // ORDERS
    //
    // Public customer:
    //   CREATE only
    //
    // Staff:
    //   READ / UPDATE / DELETE
    // ------------------------------------------------------------

    match /orders/{orderId} {
      allow create: if
        request.resource.data.inventoryOperationId == orderId
        && request.resource.data.inventoryTracked is map
        && (
          (
            request.resource.data.source == 'WEB'
            && request.resource.data.status == 'PENDING'
          )
          ||
          (
            request.resource.data.source == 'POS'
            && request.resource.data.status == 'COMPLETED'
            && staff()
          )
        );

      allow read: if staff();

      allow update: if staff()
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              'inventoryOperationId',
              'inventoryTracked'
            ])
          ||
          (
            request.resource.data.status == 'CANCELLED'
            && request.resource.data.inventoryRestored == true
            && request.resource.data.inventoryRestorationOperationId is string
          )
        );

      allow delete: if staff();
    }

    // ------------------------------------------------------------
    // ADMIN / INTERNAL DATA
    // ------------------------------------------------------------

    match /admins/{userId} {
      // A signed-in user may read only their own admin profile.
      allow get: if signedIn() && request.auth.uid == userId;

      // Super admin controls staff records.
      allow list, create, update, delete: if superAdmin();
    }

    match /analyticsDaily/{docId} {
      allow read, write: if staff();
    }

    match /analyticsMonthly/{docId} {
      allow read, write: if staff();
    }

    match /auditLogs/{docId} {
      allow read: if managerOrAbove();
      allow create: if staff();
      allow update, delete: if superAdmin();
    }

    match /printerSettings/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // CUSTOMER / LOYALTY
    //
    // TEMPORARY COMPATIBILITY:
    // Current browser implementation performs customer + loyalty
    // operations without Firebase customer authentication.
    //
    // These remain temporarily writable so existing loyalty features
    // do not break. This is NOT considered production-secure.
    // ------------------------------------------------------------

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /pointLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /pointRedemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /pointRewards/{rewardId} {
      allow read, write: if managerOrAbove();
    }

    match /pointTransactions/{transactionId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // TEST / CONNECTION
    // Read is retained because firebase.ts performs a connectivity
    // check against test/connection.
    // ------------------------------------------------------------

    match /test/{docId} {
      allow read: if true;
      allow write: if superAdmin();
    }
  }
}
