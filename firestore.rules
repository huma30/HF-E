rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function activeStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.isActive == true;
    }

    function superAdmin() {
      return activeStaff()
        && adminDoc().data.role == 'SUPER_ADMIN';
    }

    function managerOrAbove() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER'];
    }

    function staff() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'CASHIER'];
    }

    // ------------------------------------------------------------
    // PUBLIC STOREFRONT READ-ONLY DATA
    // ------------------------------------------------------------

    match /settings/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /modifierGroups/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /promos/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /deliveryAreas/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /platformLinks/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /rewards/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // PRODUCT DUPLICATE / REGISTRY DATA
    // ------------------------------------------------------------

    match /product_names/{docId} {
      allow read, write: if managerOrAbove();
    }

    match /product_skus/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // ORDERS
    //
    // Public customer:
    //   CREATE only
    //
    // Staff:
    //   READ / UPDATE / DELETE
    // ------------------------------------------------------------

    match /orders/{orderId} {
      // WEB/POS order dibuat melalui Firebase Functions
      // agar perubahan stok berlangsung dalam transaksi atomik.
      allow create: if false;

      allow read: if staff();

      // Pembatalan wajib melalui cancelOrderWithInventory.
      allow update: if staff()
        && request.resource.data.status != 'CANCELLED';

      allow delete: if staff();
    }

    // ------------------------------------------------------------
    // ADMIN / INTERNAL DATA
    // ------------------------------------------------------------

    match /admins/{userId} {
      // A signed-in user may read only their own admin profile.
      allow get: if signedIn() && request.auth.uid == userId;

      // Super admin controls staff records.
      allow list, create, update, delete: if superAdmin();
    }

    match /analyticsDaily/{docId} {
      allow read, write: if staff();
    }

    match /analyticsMonthly/{docId} {
      allow read, write: if staff();
    }

    match /auditLogs/{docId} {
      allow read: if managerOrAbove();
      allow create: if staff();
      allow update, delete: if superAdmin();
    }

    match /printerSettings/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // CUSTOMER / LOYALTY
    //
    // Spark-only security model:
    // - Customers may READ loyalty data through the existing
    //   phone-based lookup flow.
    // - Customers must NEVER be able to WRITE customer balances,
    //   ledgers, redemptions, or transaction records directly.
    // - Loyalty mutations are performed by authenticated HUMA staff.
    //
    // IMPORTANT:
    // Public READ is retained for compatibility with the current
    // phone-number lookup flow. This is a privacy limitation,
    // not proof of phone ownership.
    // ------------------------------------------------------------

    match /customers/{customerId} {
      allow read: if true;
      allow write: if staff();
    }

    match /pointLedger/{ledgerId} {
      allow read: if true;
      allow write: if staff();
    }

    match /pointRedemptions/{redemptionId} {
      allow read: if true;
      allow write: if staff();
    }

    match /pointRewards/{rewardId} {
      allow read: if true;
      allow write: if staff();
    }

    match /pointTransactions/{transactionId} {
      allow read: if true;
      allow write: if staff();
    }

    // ------------------------------------------------------------
    // TEST / CONNECTION
    // Read is retained because firebase.ts performs a connectivity
    // check against test/connection.
    // ------------------------------------------------------------

    match /test/{docId} {
      allow read: if true;
      allow write: if superAdmin();
    }
  }
}
