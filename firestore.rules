rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function activeStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.isActive == true;
    }

    function superAdmin() {
      return activeStaff()
        && adminDoc().data.role == 'SUPER_ADMIN';
    }

    function managerOrAbove() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER'];
    }

    function staff() {
      return activeStaff()
        && adminDoc().data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'CASHIER'];
    }

    // ------------------------------------------------------------
    // PUBLIC STOREFRONT READ-ONLY DATA
    // ------------------------------------------------------------

    match /settings/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /modifierGroups/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /promos/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /deliveryAreas/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /platformLinks/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    match /rewards/{docId} {
      allow read: if true;
      allow write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // PRODUCT DUPLICATE / REGISTRY DATA
    // ------------------------------------------------------------

    match /product_names/{docId} {
      allow read, write: if managerOrAbove();
    }

    match /product_skus/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // ORDERS
    //
    // Public customer:
    //   CREATE only
    //
    // Staff:
    //   READ / UPDATE / DELETE
    // ------------------------------------------------------------

    match /orders/{orderId} {
      allow create: if
        request.resource.data.source == 'WEB'
        && request.resource.data.status == 'PENDING';

      allow read, update, delete: if staff();
    }

    // ------------------------------------------------------------
    // ADMIN / INTERNAL DATA
    // ------------------------------------------------------------

    match /admins/{userId} {
      // A signed-in user may read only their own admin profile.
      allow get: if signedIn() && request.auth.uid == userId;

      // Super admin controls staff records.
      allow list, create, update, delete: if superAdmin();
    }

    match /analyticsDaily/{docId} {
      allow read, write: if staff();
    }

    match /analyticsMonthly/{docId} {
      allow read, write: if staff();
    }

    match /auditLogs/{docId} {
      allow read: if managerOrAbove();
      allow create: if staff();
      allow update, delete: if superAdmin();
    }

    match /printerSettings/{docId} {
      allow read, write: if managerOrAbove();
    }

    // ------------------------------------------------------------
    // CUSTOMER / LOYALTY
    //
    // TEMPORARY COMPATIBILITY:
    // Current browser implementation performs customer + loyalty
    // operations without Firebase customer authentication.
    //
    // These remain temporarily writable so existing loyalty features
    // do not break. This is NOT considered production-secure.
    // ------------------------------------------------------------

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /pointLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /pointRedemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /pointRewards/{rewardId} {
      allow read, write: if true;
    }

    match /pointTransactions/{transactionId} {
      allow read, write: if true;
    }

    // ------------------------------------------------------------
    // TEST / CONNECTION
    // Read is retained because firebase.ts performs a connectivity
    // check against test/connection.
    // ------------------------------------------------------------

    match /test/{docId} {
      allow read: if true;
      allow write: if superAdmin();
    }
  }
}
