rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'huma301123@gmail.com'
      );
    }
    
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function hasRole(allowedRoles) {
      return isAdminEmail() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        getAdminDoc().data.isActive == true &&
        getAdminDoc().data.role in allowedRoles
      );
    }

    // Public catalog/configuration: storefront can read, only staff can change.
    match /test/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN']);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN']);
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN']);
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /modifierGroups/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /promos/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /deliveryAreas/{docId} {
      allow read: true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /platformLinks/{docId} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    // Orders: anonymous storefront may create; staff can read/update.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if hasRole(['SUPER_ADMIN', 'MANAGER', 'CASHIER']);
      allow update: if hasRole(['SUPER_ADMIN', 'MANAGER', 'CASHIER']);
      allow delete: if hasRole(['SUPER_ADMIN', 'MANAGER']);
    }

    match /analyticsDaily/{docId} {
      allow read, write: if true;
    }

    match /analyticsMonthly/{docId} {
      allow read, write: if true;
    }

    match /auditLogs/{docId} {
      allow read, write: if true;
    }

    match /admins/{userId} {
      allow read, write: if true;
    }

    match /printerSettings/{docId} {
      allow read, write: if true;
    }

    // Customer records and Loyalty Points: Accessible by store app and staff
    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /pointLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /rewards/{rewardId} {
      allow read, write: if true;
    }

    match /pointRewards/{rewardId} {
      allow read, write: if true;
    }

    match /pointTransactions/{transactionId} {
      allow read, write: if true;
    }

    match /pointRedemptions/{redemptionId} {
      allow read, write: if true;
    }
  }
}
